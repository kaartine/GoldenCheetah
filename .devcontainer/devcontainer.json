{
  "name": "GoldenCheetah Qt 6.8",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "QT_VERSION": "6.8.3",
      "USER_UID": "1000",
      "USER_GID": "1000"
    }
  },
  "remoteUser": "ubuntu",
  "updateRemoteUserUID": true,
  "runArgs": ["--init"],
  "mounts": [
    "source=goldencheetah-ccache,target=/home/ubuntu/.cache/ccache,type=volume"
  ],
  "containerEnv": {
    "CCACHE_DIR": "/home/ubuntu/.cache/ccache",
    "CCACHE_MAXSIZE": "12G",
    "QTWEBENGINE_DISABLE_SANDBOX": "1"
  },
  "postCreateCommand": "sudo chown -R $(id -u):$(id -g) /home/ubuntu/.cache/ccache && bash .devcontainer/bootstrap.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools"
      ]
    }
  }
}
