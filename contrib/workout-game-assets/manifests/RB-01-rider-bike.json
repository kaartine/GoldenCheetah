  "processing": {
    "tool": "Blender and Qt Balsam",
    "toolVersion": "Blender 4.0.2; Qt Balsam 6.8.3",
    "steps": [
      "Start Blender with --background --factory-startup.",
      "Run generate_rider_bike.py with its dimension, pivot, topology and budget checks.",
      "Generate one normalized UV map for every source mesh.",
      "Export glTF 2.0 GLB with opaque materials, extras and no cameras, lights, textures or animations.",
      "Validate with the repository GLB policy and reproduce the GLB byte for byte.",
      "Convert the reviewed GLB twice with Qt Balsam 6.8.3 and compare every output byte.",
      "Bind the converted meshes to the deterministic runtime pose properties in WorkoutGameRiderBike.qml.",
      "Apply the shared project-authored rider pixel tile to the bike, jersey, shorts and helmet with mipmapped minification.",
      "Blend pedal, effort sway, standing climb, suspension, coast, preload, air, land, absorb, lean and bypass poses from the authoritative runtime snapshot without root motion."
    ]
  },
