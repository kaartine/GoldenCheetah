  "processing": {
    "tool": "Blender and Qt Balsam",
    "toolVersion": "Blender 4.0.2; Qt Balsam 6.8.3",
    "steps": [
      "Start Blender with --background --factory-startup.",
      "Run generate_rider_bike.py with dimension, pivot, topology, rights-metadata and budget checks.",
      "Generate one normalized UV map for every source mesh.",
      "Export glTF 2.0 GLB with opaque materials, extras and no cameras, lights, textures or animations.",
      "Generate the GLB twice with Blender 4.0.2 and require byte-identical output.",
      "Validate the GLB with repository policy and the Khronos glTF validator.",
      "Convert the candidate twice with Qt Balsam 6.8.3 and compare every generated output byte.",
      "Bind all 17 converted meshes to the existing runtime pivots and snapshot-driven animation contract.",
      "Package the converted meshes and shared rider surface texture in workout-game-assets.qrc.",
      "Render front, rear, side and chase audit views with fixed pose, cameras, field of view and lighting.",
      "Require repeated audit renders to decode to identical image pixels."
    ]
  },
