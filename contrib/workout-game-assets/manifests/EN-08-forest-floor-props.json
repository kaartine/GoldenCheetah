  "processing": {
    "tool": "Blender and Qt Balsam",
    "toolVersion": "Blender 4.0.2; Qt Balsam 6.8.3",
    "steps": [
      "Start pinned Blender 4.0.2 with --background --factory-startup.",
      "Generate sixteen original ground-anchored prop meshes with applied transforms, explicit per-variant triangle contracts and four shared materials, including rocks, deadwood, shrubs, grasses, flowers, mushrooms and saplings.",
      "Generate UV0 on every primitive for later shared-atlas use; embed no image or external URI.",
      "Export one self-contained glTF 2.0 GLB with no cameras, lights, animations or collision authority.",
      "Reproduce the GLB byte for byte and validate its manifest, bounds, topology, pivots, materials and budgets.",
      "Import the exported GLB and render three fixed 47-degree-FOV CPU catalogs with a 1.36-metre trail-width scale bar.",
      "Convert the reviewed GLB twice with Qt Balsam 6.8.3 and compare every generated mesh byte.",
      "Package the sixteen meshes behind one bounded scenery-only Qt Quick 3D variant component."
    ]
  },
