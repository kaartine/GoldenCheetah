/*
 * Deterministic QLowEnergyService test double for BT40 lifecycle tests.
 */

#ifndef GC_TEST_QLOWENERGYSERVICE_H
#define GC_TEST_QLOWENERGYSERVICE_H

#include <QBluetoothUuid>
#include <QByteArray>
#include <QHash>
#include <QList>
#include <QLowEnergyCharacteristic>
#include <QObject>

class QLowEnergyService : public QObject
{
    Q_OBJECT

public:
    enum ServiceError {
        NoError = 0,
        OperationError,
        CharacteristicWriteError,
        DescriptorWriteError,
        UnknownError,
        CharacteristicReadError,
        DescriptorReadError
    };
    Q_ENUM(ServiceError)

    enum ServiceState {
        InvalidService = 0,
        RemoteService,
        RemoteServiceDiscovering,
        RemoteServiceDiscovered,
        LocalService
    };
    Q_ENUM(ServiceState)

    enum DiscoveryMode {
        FullDiscovery,
        SkipValueDiscovery
    };
    Q_ENUM(DiscoveryMode)

    enum WriteMode {
        WriteWithResponse = 0,
        WriteWithoutResponse,
        WriteSigned
    };
    Q_ENUM(WriteMode)

    explicit QLowEnergyService(const QBluetoothUuid &uuid,
                               QObject *parent = nullptr) :
        QObject(parent), uuid(uuid)
    {
    }
    ~QLowEnergyService() override { ++destructions; }

    ServiceState state() const { return currentState; }
    QBluetoothUuid serviceUuid() const { return uuid; }

    QLowEnergyCharacteristic characteristic(const QBluetoothUuid &uuid) const
    {
        ++characteristicLookups[uuid];
        if (characteristics.contains(uuid)) {
            return QLowEnergyCharacteristic(
                    uuid, characteristics.value(uuid));
        }
        return QLowEnergyCharacteristic();
    }

    void discoverDetails(DiscoveryMode = FullDiscovery)
    {
        ++discoverCalls;
        currentState = RemoteServiceDiscovering;
    }

    void readCharacteristic(const QLowEnergyCharacteristic &) {}
    void writeCharacteristic(const QLowEnergyCharacteristic &,
                             const QByteArray &value, WriteMode)
    {
        characteristicWrites.append(value);
    }
    void writeDescriptor(const QLowEnergyDescriptor &, const QByteArray &)
    {
        ++descriptorWrites;
    }

    int characteristicLookupCount(const QBluetoothUuid &uuid) const
    {
        return characteristicLookups.value(uuid);
    }

    int discoverCallCount() const { return discoverCalls; }
    int descriptorWriteCount() const { return descriptorWrites; }
    int characteristicWriteCount() const
    {
        return characteristicWrites.size();
    }
    QList<QByteArray> characteristicWriteValues() const
    {
        return characteristicWrites;
    }
    static int destructionCount() { return destructions; }
    static void resetTestCounters() { destructions = 0; }

    void setCharacteristicForTest(
            const QBluetoothUuid &uuid,
            bool hasNotificationDescriptor = true)
    {
        characteristics.insert(uuid, hasNotificationDescriptor);
    }

    void emitCharacteristicChangedForTest(
            const QBluetoothUuid &uuid, const QByteArray &value)
    {
        emit characteristicChanged(
                QLowEnergyCharacteristic(
                        uuid, characteristics.value(uuid, false)),
                value);
    }

    void emitCharacteristicWrittenForTest(
            const QBluetoothUuid &uuid, const QByteArray &value)
    {
        emit characteristicWritten(
                QLowEnergyCharacteristic(
                        uuid, characteristics.value(uuid, false)),
                value);
    }

    void emitStateChangedForTest(ServiceState state)
    {
        currentState = state;
        emit stateChanged(state);
    }

    void emitErrorForTest(ServiceError error)
    {
        emit errorOccurred(error);
    }

signals:
    void stateChanged(QLowEnergyService::ServiceState state);
    void characteristicChanged(const QLowEnergyCharacteristic &characteristic,
                               const QByteArray &value);
    void characteristicRead(const QLowEnergyCharacteristic &characteristic,
                            const QByteArray &value);
    void characteristicWritten(const QLowEnergyCharacteristic &characteristic,
                               const QByteArray &value);
    void descriptorWritten(const QLowEnergyDescriptor &descriptor,
                           const QByteArray &value);
    void errorOccurred(QLowEnergyService::ServiceError error);

private:
    QBluetoothUuid uuid;
    ServiceState currentState = RemoteService;
    mutable QHash<QBluetoothUuid, int> characteristicLookups;
    QHash<QBluetoothUuid, bool> characteristics;
    QList<QByteArray> characteristicWrites;
    int discoverCalls = 0;
    int descriptorWrites = 0;
    inline static int destructions = 0;
};

#endif
