GC_UNITTESTS = active


########################################

include(../src/gcconfig.pri)

GC_SRC_DIR = ../../../src
INCLUDEPATH += $$GC_SRC_DIR
INCLUDEPATH += $${GSL_INCLUDES}

CONFIG += testcase
CONFIG += no_testcase_installs
CONFIG += c++17

!isEmpty(GC_OBJS):error("GC_OBJS is unsupported; compile or link an explicit production target")
