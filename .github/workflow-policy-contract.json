{
  "format": "goldencheetah-workflow-policy-3",
  "policy_workflow": {
    "base_branch": "master",
    "file": "workflow-policy.yml",
    "job": "immutable-actions",
    "pull_request_types": [
      "opened",
      "edited",
      "reopened",
      "synchronize",
      "ready_for_review"
    ],
    "status_context": "Workflow policy / immutable actions"
  },
  "build_workflows": {
    "ci.yml": {
      "candidate_jobs": {
        "linux": [
          "Checkout authorized source",
          "Install Qt",
          "Build and test Linux"
        ],
        "macos": [
          "Checkout authorized source",
          "Build",
          "Test",
          "Upload dmg"
        ],
        "windows": [
          "Checkout authorized source",
          "Install Qt",
          "Configure MSVC",
          "Build and test Windows"
        ]
      },
      "candidate_runs_on": {
        "linux": "ubuntu-22.04",
        "macos": "macos-latest",
        "windows": "windows-2025"
      },
      "candidate_step_count": {
        "linux": 3,
        "macos": 4,
        "windows": 4
      },
      "path_filters": [
        "**"
      ],
      "status_context": "Candidate CI / build"
    },
    "ridecache-removal-native.yml": {
      "candidate_jobs": {
        "linux": [
          "Install build dependencies",
          "Build GUI-010 regression tests",
          "Run GUI-010 regression tests"
        ],
        "macos": [
          "Install build dependencies",
          "Build native activity tests",
          "Run native activity tests"
        ],
        "windows": [
          "Install build dependencies",
          "Build native activity tests",
          "Run native activity tests"
        ]
      },
      "candidate_runs_on": {
        "linux": "ubuntu-24.04",
        "macos": "macos-15",
        "windows": "windows-2025"
      },
      "candidate_step_count": {
        "linux": 5,
        "macos": 5,
        "windows": 6
      },
      "path_filters": [
        ".github/workflows/ridecache-removal-native.yml",
        "contrib/qzip/zip.*",
        "src/Core/LinkedActivityRemovalJournal.*",
        "src/Core/LinkedActivitySaveJournal.*",
        "src/Core/PlannedActivityFileStager.*",
        "src/Core/RideCache*.*",
        "src/Core/Season.*",
        "src/Core/Seasons.*",
        "src/Charts/CalendarSeasonWorkflow.h",
        "src/Charts/CalendarWindow.*",
        "src/FileIO/AnchoredFileSystem.*",
        "src/FileIO/AtomicFileWriter.*",
        "src/FileIO/JsonRideFile.*",
        "src/FileIO/RideFile*.*",
        "src/Gui/SaveDialogs.*",
        "src/Gui/ModalWorkflowGuard.h",
        "src/Gui/AnalysisSidebar.*",
        "src/Gui/FilterSimilarDialog.*",
        "src/Gui/ManualActivityWizard.*",
        "src/Gui/PlanWizards.*",
        "src/Metrics/BlinnSolver.*",
        "src/Planning/PlanBundle*.*",
        "src/Planning/PlanReplacementJournal.*",
        "unittests/Core/linkedActivitySaveCleanup/**",
        "unittests/Core/rideCacheRemoval/**",
        "unittests/Core/seasonParser/**",
        "unittests/Gui/calendarModalWorkflow/**",
        "unittests/FileIO/atomicActivitySave/**",
        "unittests/FileIO/anchoredFilesystem/**",
        "unittests/Planning/**"
      ],
      "status_context": "Candidate CI / native activity transactions"
    },
    "windows-durable-filesystem.yml": {
      "candidate_jobs": {
        "macos": [
          "Build anchored filesystem test",
          "Run anchored filesystem test"
        ],
        "windows": [
          "Build test",
          "Run test"
        ]
      },
      "candidate_runs_on": {
        "macos": "macos-15",
        "windows": "windows-2025"
      },
      "candidate_step_count": {
        "macos": 4,
        "windows": 5
      },
      "path_filters": [
        ".github/workflows/windows-durable-filesystem.yml",
        "src/FileIO/AnchoredFileSystem.cpp",
        "src/FileIO/AnchoredFileSystem.h",
        "src/FileIO/AtomicFileWriter.h",
        "unittests/FileIO/anchoredFilesystem/**",
        "unittests/FileIO/durableFilesystem/**"
      ],
      "status_context": "Candidate CI / durable and anchored filesystem"
    }
  }
}
