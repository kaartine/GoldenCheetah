{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldencheetah.org/schemas/workout-game-asset-manifest.json",
  "title": "Workout Game Asset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assetId",
    "displayName",
    "role",
    "source",
    "license",
    "files",
    "technical",
    "review"
  ],
  "properties": {
    "assetId": {
      "type": "string",
      "pattern": "^[A-Z]{2}-[0-9]{2}(-[a-z0-9-]+)?$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "enum": [
        "rider-bike",
        "trail-tile",
        "feature",
        "terrain",
        "vegetation",
        "prop",
        "effect",
        "texture",
        "reference"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "provider", "author", "url", "retrievedAt"],
      "properties": {
        "kind": {
          "enum": ["project-authored", "external", "generated"]
        },
        "provider": { "type": "string", "minLength": 1 },
        "author": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "downloadUrl": { "type": "string", "format": "uri" },
        "providerAssetId": { "type": "string" },
        "providerRevision": { "type": "string" },
        "retrievedAt": { "type": "string", "format": "date" },
        "originalFileName": { "type": "string" },
        "originalSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "generator": { "type": "string" },
        "generatorVersion": { "type": "string" },
        "promptOrScript": { "type": "string" }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spdxId",
        "licenseUrl",
        "modificationAllowed",
        "redistributionAllowed",
        "decision"
      ],
      "properties": {
        "spdxId": { "type": "string", "minLength": 1 },
        "licenseUrl": { "type": "string", "format": "uri" },
        "attribution": { "type": "string" },
        "modificationAllowed": { "type": "boolean" },
        "redistributionAllowed": { "type": "boolean" },
        "decision": { "enum": ["allow", "conditional", "reject"] },
        "policyVersion": { "type": "string" },
        "archivedLicensePath": { "type": "string" },
        "distributionScopes": {
          "type": "array",
          "items": {
            "enum": ["source", "appimage", "screenshots-video"]
          },
          "uniqueItems": true
        },
        "conditions": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "reviewNotes": { "type": "string" }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "purpose", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "purpose": {
            "enum": [
              "source",
              "runtime",
              "intermediate",
              "texture",
              "license",
              "reference",
              "preview"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": { "type": "string" },
        "toolVersion": { "type": "string" },
        "steps": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "technical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "unitMeters", "upAxis", "forwardAxis"],
      "properties": {
        "format": { "enum": ["glb", "png", "webp", "blend", "other"] },
        "unitMeters": { "const": 1.0 },
        "upAxis": { "const": "+Y" },
        "forwardAxis": { "const": "+Z" },
        "trianglesLod0": { "type": "integer", "minimum": 0 },
        "trianglesLod1": { "type": "integer", "minimum": 0 },
        "trianglesLod2": { "type": "integer", "minimum": 0 },
        "glbBytes": { "type": "integer", "minimum": 1 },
        "materials": { "type": "integer", "minimum": 0 },
        "textureBytes": { "type": "integer", "minimum": 0 },
        "nodes": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "animations": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "allowedExtensions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "boundsMeters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum"],
          "properties": {
            "minimum": {
              "type": "array",
              "minItems": 3,
              "prefixItems": [
                { "type": "number" },
                { "type": "number" },
                { "type": "number" }
              ],
              "items": false
            },
            "maximum": {
              "type": "array",
              "minItems": 3,
              "prefixItems": [
                { "type": "number" },
                { "type": "number" },
                { "type": "number" }
              ],
              "items": false
            }
          }
        },
        "sockets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "positionMeters", "halfWidthMeters"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "positionMeters": {
                "type": "array",
                "minItems": 3,
                "prefixItems": [
                  { "type": "number" },
                  { "type": "number" },
                  { "type": "number" }
                ],
                "items": false
              },
              "halfWidthMeters": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        },
        "budgets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxGlbBytes",
            "maxTrianglesLod0",
            "maxMaterials",
            "maxTextureBytes"
          ],
          "properties": {
            "maxGlbBytes": { "type": "integer", "minimum": 1 },
            "maxTrianglesLod0": { "type": "integer", "minimum": 0 },
            "maxMaterials": { "type": "integer", "minimum": 0 },
            "maxTextureBytes": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["candidate", "approved", "rejected"] },
        "trademarkStatus": {
          "enum": ["not-applicable", "clear", "review-required", "rejected"]
        },
        "personReleaseStatus": {
          "enum": ["not-applicable", "clear", "review-required", "rejected"]
        },
        "propertyReleaseStatus": {
          "enum": ["not-applicable", "clear", "review-required", "rejected"]
        },
        "reviewer": { "type": "string" },
        "reviewedAt": { "type": "string", "format": "date" },
        "notes": { "type": "string" }
      }
    }
  }
}
